{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python harness_hook_session_start.py",
            "statusMessage": "하네스 상태 확인 중...",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python harness_hook_session_stop.py",
            "statusMessage": "파일 스냅샷 저장 중...",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
